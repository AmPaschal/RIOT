{
    "editor.rulers": [
        80,
        100
    ],
    "editor.detectIndentation": false,
    "files.insertFinalNewline": true,
    "files.associations": {
        ".clang-tidy": "raw",
        "Makefile.*": "makefile",
        "*.mk": "makefile",
        "*.sketch": "cpp",
        "*.inc": "c",
        "cstdint": "c",
        "*.ipp": "cpp",
        "*.tcc": "cpp",
        "iostream": "cpp",
        "streambuf": "cpp",
        "core": "cpp",
        "__availability": "cpp",
        "compare": "c",
        "cstdlib": "c",
        "array": "c",
        "tuple": "c",
        "type_traits": "c",
        "utility": "c",
        "variant": "c",
        "limits": "c",
        "hash_map": "c",
        "format": "c",
        "initializer_list": "c",
        "span": "c",
        "valarray": "c",
        "bitset": "c",
        "ranges": "c",
        "string": "c",
        "string_view": "c",
        "cassert": "c",
        "assert.h": "c",
        "hash_set": "c",
        "stdlib.h": "c",
        "rb.h": "c",
        "hdr.h": "c",
        "minfwd.h": "c",
        "ipv6.h": "c",
        "pkt.h": "c",
        "chrono": "c",
        "functional": "c",
        "istream": "c",
        "ostream": "c",
        "ratio": "c",
        "addr.h": "c",
        "dns.h": "c",
        "udp.h": "c",
        "sock_types.h": "c",
        "types.h": "c",
        "msg.h": "c",
        "af.h": "c",
        "sock.h": "c",
        "byteorder.h": "c",
        "inet.h": "c",
        "errno.h": "c",
        "executor": "c",
        "cstring": "c",
        "architecture.h": "c",
        "string.h": "c",
        "clif.h": "c",
        "clif_internal.h": "c",
        "stdio.h": "c",
        "evtimer_msg.h": "c",
        "buffer": "c",
        "internet": "c",
        "socket": "c",
        "gnrc_tcp_common.h": "c"
    },
    "[shellscript][c][cpp]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
    },
    "[makefile]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
    },
    "cmake.ignoreCMakeListsMissing": true,
}
