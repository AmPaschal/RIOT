diff --git a/cbmc/codex_tests/_receive/Makefile b/cbmc/codex_tests/_receive/Makefile
new file mode 100644
index 0000000000000000000000000000000000000000..2fd1d168ad254b57828313058d39340618d45c3e
--- /dev/null
+++ b/cbmc/codex_tests/_receive/Makefile
@@ -0,0 +1,28 @@
+# Defines the root of the project.
+# Be aware of how many directories deep you go!
+
+ROOT ?= ../../..
+
+# Harness to utilize, omit the extension!
+H_ENTRY = _receive
+
+# Extra CBMC flags to be passed during CBMC analysis
+H_CBMCFLAGS = --nondet-static --unwind 2
+
+# Env vars
+H_DEF = -DMODULE_GNRC_IPV6=1 -DMODULE_GNRC_NETTYPE_IPV6=1 -DMODULE_GNRC_NETTYPE_TCP=1
+
+# Includes
+H_INC = -I$(ROOT) \
+        -I$(ROOT)/sys/include/  \
+        -I$(ROOT)/core/lib/include/  \
+        -I$(ROOT)/core/include/  \
+        -I$(ROOT)/cpu/native/include/  \
+        -I$(ROOT)/drivers/include/ \
+
+# No additional link files needed since the harness includes the implementation directly
+LINK =
+
+# Include our special build file
+MAKE_INCLUDE_PATH ?= ..
+include $(MAKE_INCLUDE_PATH)/Makefile.include
